---
import type { RenderedContent } from "astro:content";
import type { InferEntrySchema } from "astro:content";

const { project: progetto, compact = false } = Astro.props as {
  project: {
    id: string;
    body?: string;
    collection: "progetti";
    data: InferEntrySchema<"progetti">;
    rendered?: RenderedContent;
    filePath?: string;
  };
  compact?: boolean;
};

const statusDotClass =
  progetto.data.status === "Active"
    ? "bg-green-400"
    : progetto.data.status === "In Progress"
      ? "bg-yellow-400"
      : progetto.data.status === "Demo"
        ? "bg-blue-400"
        : "bg-red-400";
---

{
  compact ? (
    <div class="w-full h-full flex flex-col gap-2 p-4 bg-white rounded-lg">
      <div class="relative w-full">
        <a href={`progetti/${progetto.id}`}>
          {progetto.data.image == "" && (
            <h3 class="absolute top-[50%] left-[50%] text-center transform translate-y-[-50%] translate-x-[-50%] text-xl text-black opacity-30 font-bold tracking-wider px-2">
              {progetto.data.name}
            </h3>
          )}
          <img
            src={
              progetto.data.image != ""
                ? progetto.data.image
                : "/images/projects/temporary-banner.png"
            }
            alt={progetto.data.name}
            class="w-full h-32 object-cover rounded-lg object-left"
          />
        </a>
      </div>

      <div class="flex items-center uppercase text-xs mt-2">
        <span
          class={`rounded-full inline-block w-2 h-2 shadow-lg mr-2 ${statusDotClass}`}
        />
        {progetto.data.status}
      </div>
      <p class="text-[#189bc6] font-medium text-xs uppercase tracking-wide">
        {progetto.data.type}
      </p>
      <a href={`progetti/${progetto.id}`}>
        <h3 class="font-medium text-lg">{progetto.data.name}</h3>
      </a>
      <p class="text-sm text-gray-600">{progetto.data.description}</p>
      {progetto.data.linkToProject && (
        <a
          href={`${progetto.data.linkToProject}`}
          target="_blank"
          class="inline-block font-medium text-gray-800 text-sm"
        >
          Go to live project
          <span class="inline-block ml-1">→</span>
        </a>
      )}
      <div class="flex flex-wrap items-center gap-2 mt-auto pt-2">
        {progetto.data.tech_stack.map((tech: string) => (
          <span class="bg-[#f4f3ed] border border-[#d7d7d2] rounded-full px-2 py-0.5 text-[0.65rem] uppercase">
            {tech}
          </span>
        ))}
      </div>
    </div>
  ) : (
    <div class="w-full relative flex flex-col lg:flex-row gap-8 p-4 bg-white rounded-lg">
      <div class="w-full lg:w-1/2 flex flex-col">
        <div class="flex items-center uppercase text-sm mb-4">
          <span
            class={`rounded-full inline-block w-2 h-2 shadow-lg mr-2 ${statusDotClass}`}
          />
          {progetto.data.status}
        </div>
        <p class="text-[#189bc6] font-medium text-sm uppercase tracking-wide">
          {progetto.data.type}
        </p>
        <a href={`progetti/${progetto.id}`}>
          <h3 class="font-medium text-2xl">{progetto.data.name}</h3>
        </a>
        <p class="my-4">{progetto.data.description}</p>
        {progetto.data.linkToProject && (
          <a
            href={`${progetto.data.linkToProject}`}
            target="_blank"
            class="my-4 inline-block font-medium text-gray-800"
          >
            Go to live project
            <span class="inline-block ml-1">→</span>
          </a>
        )}
        <div class="flex flex-wrap items-center gap-2 mt-4 lg:mt-auto">
          {progetto.data.tech_stack.map((tech: string) => (
            <span class="bg-[#f4f3ed] border border-[#d7d7d2] rounded-full px-2 py-1 text-xs uppercase">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <div class="relative w-full lg:w-1/2">
        <a href={`progetti/${progetto.id}`} class="">
          {progetto.data.image == "" && (
            <h3 class="absolute top-[50%] left-[50%] text-center transform translate-y-[-50%] translate-x-[-50%] text-3xl text-black opacity-30 font-bold tracking-wider">
              {progetto.data.name}
            </h3>
          )}

          <img
            src={
              progetto.data.image != ""
                ? progetto.data.image
                : "/images/projects/temporary-banner.png"
            }
            alt={progetto.data.name}
            class="w-full h-full object-cover rounded-xl object-left"
          />
        </a>
      </div>
    </div>
  )
}
