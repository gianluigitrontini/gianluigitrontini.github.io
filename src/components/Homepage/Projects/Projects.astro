---
import { getCollection } from "astro:content";
import ProjectCardContent from "../Projects/ProjectCardContent.astro";
const res = await getCollection("progetti", ({ data }: { data: any }) => {
  return data.hidden == false;
});

const byDateDesc = (a: any, b: any) => b.data.date - a.data.date;

const featured = res
  .filter((p: any) => p.data.tier === "featured")
  .sort(byDateDesc);
const secondary = res
  .filter((p: any) => p.data.tier === "secondary")
  .sort(byDateDesc);
const other = res.filter((p: any) => p.data.tier === "other").sort(byDateDesc);

// Group featured projects by year using Map
const groupedProjects = new Map<string, typeof featured>();
featured.forEach((progetto: any) => {
  const year = progetto.data.year_label;

  if (!groupedProjects.has(year)) {
    groupedProjects.set(year, []);
  }
  groupedProjects.get(year)?.push(progetto);
});
---

<section id="projects" class="py-12">
  <h2 class="container font-secondary mb-20 text-5xl text-center">Projects</h2>

  <div class="mx-auto max-w-5xl px-2 flex flex-col gap-4 lg:gap-8">
    {
      Array.from(groupedProjects.entries()).map(([year, projects]) => (
        <div class="flex flex-col gap-4 lg:gap-8">
          <h3 class=" sticky top-20 font-secondary text-3xl font-bold self-start z-10 py-4">
            Since {year}
          </h3>

          {projects.map((progetto) => (
            <div class="sticky-project top-36 bg-[#f4f3ed] rounded-xl shadow-xl">
              <ProjectCardContent project={progetto} />
            </div>
          ))}
        </div>
      ))
    }
  </div>

  {
    secondary.length > 0 && (
      <div class="mx-auto max-w-5xl px-2 mt-24">
        <h3 class="font-secondary text-3xl font-bold text-center mb-12">
          More Projects
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {secondary.map((progetto) => (
            <div class="bg-[#f4f3ed] rounded-xl shadow-lg">
              <ProjectCardContent project={progetto} compact />
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    other.length > 0 && (
      <div class="mx-auto max-w-5xl px-2 mt-20 text-center">
        <h3 class="font-secondary text-2xl font-bold mb-6">Other Work</h3>
        <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-3">
          {other.map((progetto) => (
            <li>
              <a
                href={progetto.data.linkToProject || `progetti/${progetto.id}`}
                target={progetto.data.linkToProject ? "_blank" : undefined}
                rel={progetto.data.linkToProject ? "noreferrer" : undefined}
                class="font-medium underline"
              >
                {progetto.data.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style is:global>
  .sticky-project {
    @apply sticky top-36;

    transition:
      transform 0.5s ease,
      opacity 0.5s ease;
  }

  .scaled {
    transform: scale(0.95); /* Adjust scale as needed */
    opacity: 0.25;
  }
</style>

<script>
  const items: NodeListOf<HTMLElement> =
    document.querySelectorAll(".sticky-project");
  const STICKY_OFFSET = 150; // must match CSS `top` value
  const HIDE_THRESHOLD = 0.75; // opacity below which we consider it "settled/hidden"

  let ticking = false;

  // only the "settled" state classes — keep transition-* on the elements
  // permanently in your markup/CSS so the animation always has something to interpolate from
  const settledClasses = ["scale-95", "top-36"];

  function updateOpacities() {
    for (let i = 0; i < items.length - 1; i++) {
      const current: HTMLElement = items[i];
      const next = items[i + 1];
      const nextTop = next.getBoundingClientRect().top;

      const FADE_DISTANCE = current.clientHeight * 0.75;
      const distance = nextTop - STICKY_OFFSET;

      let opacity = 1;
      if (distance < FADE_DISTANCE) {
        opacity = Math.max(0, Math.min(1, distance / FADE_DISTANCE));
      }

      const isSettled = opacity <= HIDE_THRESHOLD;

      current.style.opacity = opacity.toString();
      if (isSettled) {
        current.classList.add(...settledClasses);
      } else {
        current.classList.remove(...settledClasses);
      }
    }
    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(updateOpacities);
      ticking = true;
    }
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  updateOpacities();
</script>
