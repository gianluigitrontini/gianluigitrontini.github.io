---
import { getCollection } from "astro:content";

import Icon from "../../components/Icon.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import { render } from "astro:content";

export const getStaticPaths = async () => {
  const progetti = await getCollection("progetti");
  return progetti.map((progetto: any) => ({
    params: {
      slug: progetto.id,
    },
    props: { progetto },
  }));
};

const { progetto } = Astro.props;
const { Content: MarkdownContent } = await render(progetto);
---

<MainLayout>
  <section class="flex flex-col lg:flex-row p-0">
    {/* Content Block */}
    <div class="lg:w-1/3 flex flex-col p-4 bg-gray-50">
      <div class="sticky top-0 bg-gray-50 p-4 h-fit">
        <a href={"/#projects"}>
          <span class="my-4 block uppercase underline">Back to Homepage</span>
        </a>

        {
          progetto.data.logo && (
            <img
              src={progetto.data.logo}
              class="mr-auto max-w-[12rem] h-16 object-contain my-4"
              alt=""
            />
          )
        }

        <div class="text-left w-full">
          <span class="font-medium">
            <h3 class="text-2xl mb-2">{progetto.data.name}</h3>

            {
              progetto.data.linkToProject && (
                <a
                  href={`${progetto.data.linkToProject}`}
                  target="_blank"
                  class="my-4 inline-block font-medium text-[#189bc6]"
                >
                  Go to live project
                  <span class="inline-block ml-1">→</span>
                </a>
              )
            }
          </span>

          <p class="text-gray-500">{progetto.data.description}</p>
        </div>
      </div>
    </div>

    <div class="order-1 lg:w-2/3 h-full overflow-auto">
      <div class="max-w-xl p-4 mx-auto">
        {/* Project Content */}
        <main class="lg:min-h-[100vh] pb-64 pt-4 lg:pb-4 lg:flex">
          <section class="text-left py-4 w-full markdown">
            <MarkdownContent />
          </section>
        </main>
      </div>
    </div>
  </section>
</MainLayout>
